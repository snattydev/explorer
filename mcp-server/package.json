{
  "name": "@openscan/mcp-server",
  "version": "0.1.0",
  "description": "OpenScan MCP Server with x402 payments - AI agents pay per-request for blockchain explorer access",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js --stdio"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "thirdweb": "^5.97.1",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.24.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "x402",
    "blockchain",
    "explorer",
    "ai-agents",
    "payments",
    "avalanche"
  ]
}
